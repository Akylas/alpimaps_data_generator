# Anchored with a leading slash: these name things at the top of the repository, and an
# unanchored pattern matches every path segment of that name anywhere below it. `valhalla`
# was hiding cairn/core/src/valhalla/ - the whole routing module - from git.
/valhalla
valhalla_tiles
elevation_tiles
/prime_server
/planetiler
/alpimaps_mbtiles
/venv
/tippecanoe
__pycache__
cache
*.tif
*.poly
data
.yarn
*.tif
*.mbtiles
*.etiles
*.vtiles
*.geojson
work_france_ign

# release tooling
node_modules/

# benchmark output: the scripts are tracked, the archives and logs they produce are not
bench/*.log
bench/*.tsv.gz
bench/terrain/
.terrain_rgb/
build_tiles.log
*.aux.xml
route_symbols.json
valhalla_tiles.tar

# Bundled at package time by scripts/bundle_resources.sh - the jar, the CLI, valhalla.json and
# the collected dylibs. Large, machine-specific, and rebuilt on every release.
cairn/src-tauri/resources/*
!cairn/src-tauri/resources/.gitkeep
cairn/src-tauri/frameworks/*
!cairn/src-tauri/frameworks/.gitkeep
