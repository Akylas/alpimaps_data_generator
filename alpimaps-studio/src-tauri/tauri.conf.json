{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlpiMaps Studio",
  "version": "0.1.0",
  "identifier": "com.alpimaps.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "bash -c 'if [ \"$(uname)\" = Darwin ]; then ../../scripts/bundle_macos_dylibs.sh target/release/alpimaps-studio src-tauri/resources/Frameworks @executable_path/../Resources/Frameworks; fi'"
  },
  "app": {
    "windows": [
      {
        "title": "AlpiMaps Studio",
        "width": 900,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "resources": {
      "resources/": "resources/",
      "resources/Frameworks/": "Frameworks/"
    }
  }
}
