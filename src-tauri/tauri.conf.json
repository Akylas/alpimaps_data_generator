{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cairn",
  "version": "0.1.1",
  "identifier": "com.akylas.cairn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "bash ../scripts/bundle_resources.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Cairn",
        "width": 900,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": "resources/",
      "frameworks/": "Frameworks/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
