# Patterns are anchored with a leading slash wherever they name something at the top of the
# repository: an unanchored pattern matches every path segment of that name anywhere below it.
# `valhalla` once hid crates/core/src/valhalla/ - the whole routing module - from git.

# --- vendored tools: submodules, and what they build ---------------------------------------
/valhalla/build
/planetiler/planetiler-dist/target
/venv

# --- build output --------------------------------------------------------------------------
node_modules/
/dist
/target

# Bundled at package time by scripts/bundle_resources.sh - the jar, the CLI, valhalla.json and
# the collected dylibs. Large, machine-specific, and rebuilt on every release.
/src-tauri/resources/*
!/src-tauri/resources/.gitkeep
/src-tauri/frameworks/*
!/src-tauri/frameworks/.gitkeep
/src-tauri/gen/

# --- data: never committed -----------------------------------------------------------------
/output
/data
/.cache
/.terrain_rgb
/elevation_tiles
/valhalla_tiles
/valhalla_tiles.tar
/alpimaps_mbtiles
/alpimaps-studio
/work_france_ign
/scripts/cache/
/tools/legacy/**/cache/
*.tif
*.aux.xml
*.mbtiles
*.pmtiles
*.etiles
*.vtiles
*.pbf
*.poly
*.geojson
*.log
route_symbols.json

# ...except the sample areas
!/crates/core/tests/fixtures/*.log
!/examples/areas/*.poly
!/examples/areas/*.geojson

# benchmark output: the scripts are tracked, the archives they produce are not
/tools/bench/*.tsv.gz
/tools/bench/terrain/

# --- local ---------------------------------------------------------------------------------
__pycache__/
.DS_Store
.vscode/
.idea/
.claude/
.env
.env.*
!.env.example
