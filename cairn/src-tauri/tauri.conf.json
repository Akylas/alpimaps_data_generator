{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cairn",
  "version": "0.1.2",
  "identifier": "com.akylas.cairn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "bash -c 'for p in ../scripts ../../scripts scripts; do [ -f \"$p/bundle_resources.sh\" ] && exec bash \"$p/bundle_resources.sh\"; done; echo \"bundle_resources.sh not found from $(pwd)\" >&2; exit 1'"
  },
  "app": {
    "windows": [
      {
        "title": "Cairn",
        "width": 900,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "resources": {
      "resources/": "resources/",
      "frameworks/": "Frameworks/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
